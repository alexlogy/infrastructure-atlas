# Settings for the Docker stack in docker/compose.yml. Copy to docker/.env (gitignored) and fill in.
# Example values only; never commit real credentials.

# Public address of the site, baked into the image at build time (rebuild after changing it).
NEXT_PUBLIC_SITE_URL=https://portfolio.example.com

# Long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=

# Database created by the stack's PostgreSQL container on first start.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
POSTGRES_DB=infrastructure_atlas

# Host port the app listens on (bound to 127.0.0.1; put a TLS reverse proxy in front).
APP_PORT=3000

# Optional: Ghost Content API (read-only key), Ghost webhook secret, extra CSP image origins.
GHOST_URL=
GHOST_CONTENT_API_KEY=
REVALIDATION_SECRET=
CSP_IMG_ORIGINS=
