# Example values only; do not place real credentials in Git.
# Copy to `.env` for local development. `.env` is gitignored.

# --- Server-only ---------------------------------------------------------
# Matches the local Docker Compose database (docker compose up -d db).
DATABASE_URI=postgresql://app_user:change-me@localhost:5432/infrastructure_atlas
# Used by integration and e2e tests; created automatically by docker/postgres/init.
TEST_DATABASE_URI=postgresql://app_user:change-me@localhost:5432/infrastructure_atlas_test
# Long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Optional external Ghost Content API integration (read-only Content API key).
GHOST_URL=
GHOST_CONTENT_API_KEY=

# Optional extra image origins allowed by the Content Security Policy, space or comma separated.
# The GHOST_URL origin is always allowed; add a CDN here if Ghost serves images from elsewhere.
# CSP_IMG_ORIGINS=https://images.example.com

# Development only: set to false to apply migrations instead of auto-pushing schema changes.
# PAYLOAD_DB_PUSH=true

# Optional Ghost webhook signing secret (at least 32 characters, e.g. `openssl rand -hex 32`).
# Use the same value as the Secret on Ghost webhooks targeting /api/revalidate/ghost.
REVALIDATION_SECRET=

# --- Safe to expose to the browser (NEXT_PUBLIC_ prefix) -----------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local Docker Compose database (optional overrides) ------------------
# POSTGRES_USER=app_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=infrastructure_atlas
